{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Coverage Report",
      "type": "shell",
      "command": "${workspaceFolder}/tasks/lcov.sh",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "echo": true,
        "showReuseMessage": false,
        "clear": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
